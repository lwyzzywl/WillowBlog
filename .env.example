# ============================================================================
# WillowBlog 环境变量模板
# ----------------------------------------------------------------------------
# 复制成 .env.local 后填入真实值（.env.local 已在 .gitignore 中，不会进仓库）
#
#   copy .env.example .env.local        （Windows）
#   cp .env.example .env.local          （macOS / Linux）
# ============================================================================

# Supabase 项目地址：Dashboard → Project Settings → Data API → Project URL
# 形如 https://abcdefghijklmn.supabase.co
VITE_SUPABASE_URL=

# Supabase 公开密钥（publishable key，可安全地打包进前端）
# 新版：Project Settings → API Keys → Publishable key（sb_publishable_...）
# 旧版项目对应 anon public key（eyJhbGciOi... 开头的 JWT），两个变量填哪个都行
VITE_SUPABASE_PUBLISHABLE_KEY=

# 兼容旧版命名：若你的项目仍叫 anon key，可填这一项，代码会兜底读取
VITE_SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------------
# 绝对不要放进前端的密钥（下面两项仅作提醒，永远不要填写到 Vite 变量里）
#   * SUPABASE_SERVICE_ROLE_KEY   —— 会绕过 RLS，一旦打包进前端等于把数据库交出去
#   * 数据库密码 / secret key      —— 只保存在密码管理器里
# 本项目前端只使用 publishable / anon key，权限完全由 PostgreSQL RLS 强制。
# ----------------------------------------------------------------------------
